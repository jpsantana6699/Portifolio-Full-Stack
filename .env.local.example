# ==========================================================================
# Envio de email do formulário de contato (rota /api/contact via Nodemailer)
# --------------------------------------------------------------------------
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA comite o .env.local (já está no .gitignore).
#
# Como usar com o GMAIL (recomendado, grátis):
#   1. Ative a verificação em 2 etapas na sua Conta Google.
#   2. Gere uma "Senha de app" em: https://myaccount.google.com/apppasswords
#      (escolha "Email" / "Outro" -> nomeie de "Portfolio").
#   3. Use o email no SMTP_USER e a senha de app (16 letras) no SMTP_PASS.
#
# No NETLIFY: adicione essas mesmas variáveis em
#   Site settings -> Environment variables (e refaça o deploy).
# ==========================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras

# Para onde os contatos serão enviados (se vazio, usa o SMTP_USER):
CONTACT_TO=jpsantana003@gmail.com

# Domínio do site (usado no SEO/OpenGraph):
NEXT_PUBLIC_SITE_URL=https://joaopedrotech.netlify.app
